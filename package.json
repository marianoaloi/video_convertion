{
  "name": "video-convertion",
  "version": "0.1.0",
  "description": "Command-line batch video conversion for Windows and Linux (port of the VideoEditor Jobs backend)",
  "type": "module",
  "private": true,
  "bin": {
    "vconv": "dist/src/cli/main.js"
  },
  "engines": {
    "node": ">=18.20.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"dist/tests/**/*.test.js\"",
    "start": "node dist/src/cli/main.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
