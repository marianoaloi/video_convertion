#!/bin/sh
# Launcher: resolves its own location through symlinks, then runs the built CLI.
SOURCE="$0"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  case "$SOURCE" in
    /*) ;;
    *) SOURCE="$DIR/$SOURCE" ;;
  esac
done
DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
MAIN="$DIR/../dist/src/cli/main.js"
if [ ! -f "$MAIN" ]; then
  echo "vconv is not built: run \`npm install && npm run build\` in $(cd "$DIR/.." && pwd)" >&2
  exit 2
fi
exec node "$MAIN" "$@"
